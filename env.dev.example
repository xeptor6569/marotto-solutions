# Template for the dev instance (dev.marottosolutions.com).
#
# Copy to `.env` on the host running the dev stack:
#   cp env.dev.example .env
#
# Named without a leading dot because `.env*` is gitignored. The GitHub
# "dev" environment produces the same file automatically on deploy; this copy
# is for bringing the stack up by hand.

# --- Stack identity -----------------------------------------------------
# These four are what keep dev off prod's containers, ports and volumes.
# Changing any of them without changing the others will collide with prod.
STACK_NAME=marotto-dev
COMPOSE_PROJECT_NAME=marotto-dev
APP_PORT=3082
POSTGRES_PORT=5434

# Marks this instance as non-production: shows the DEV banner, serves a
# noindex robots.txt, emits browser source maps, and refuses live Stripe keys.
APP_ENV=dev

# --- Auth ---------------------------------------------------------------
# Must be a different secret than prod so dev sessions cannot be replayed
# against production.
NEXTAUTH_SECRET=change-me-not-the-prod-secret
AUTH_SECRET=change-me-not-the-prod-secret
NEXTAUTH_URL=https://dev.marottosolutions.com
AUTH_URL=https://dev.marottosolutions.com
AUTH_TRUST_HOST=true

# --- Email --------------------------------------------------------------
# Points at the mailpit sink in docker-compose.dev.yml: mail is captured at
# http://127.0.0.1:8025 instead of being delivered. Pointing this at a real
# SMTP server means dev can email real customers, which restored production
# data makes very easy to do by accident.
#
# Do not remove it. `.env` is inside the Docker build context and the Auth.js
# nodemailer provider is constructed during `next build`, so an unset
# EMAIL_SERVER fails the build rather than merely disabling email.
EMAIL_SERVER=smtp://mailpit:1025
EMAIL_FROM=dev@marottosolutions.com

# --- Database -----------------------------------------------------------
# Unset uses the dev stack's own bundled Postgres. Never point this at prod.
# DATABASE_URL=postgresql://marotto:marotto_password@postgres:5432/marotto_db

# --- Stripe -------------------------------------------------------------
# Test keys only. The app refuses to initialize a live key when APP_ENV=dev.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Scheduler ----------------------------------------------------------
# The cron sidecar is behind a compose profile on dev and does not start by
# default. This only matters if you run it with `--profile cron`.
# CRON_SECRET=dev-cron-secret

# --- Debug tool ports (bound to 127.0.0.1 only) -------------------------
# MAILPIT_UI_PORT=8025
# ADMINER_PORT=8083
# PRISMA_STUDIO_PORT=5555
