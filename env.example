# Environment template. Copy to `.env` and fill in your values:
#   cp env.example .env
#
# Named without a leading dot because `.env*` is gitignored.
# (The dev-instance template is env.dev.example.)

# --- Core (required) ------------------------------------------------------

# Postgres connection. With the bundled docker compose, the in-network default
# is postgresql://marotto:marotto_password@postgres:5432/marotto_db
# From the host (compose publishes Postgres on POSTGRES_PORT, default 5433):
DATABASE_URL=postgresql://marotto:marotto_password@localhost:5433/marotto_db

# Auth.js session secret — generate with: openssl rand -base64 32
# Compose passes the same value as AUTH_SECRET.
NEXTAUTH_SECRET=change-me

# The exact public URL you open the app on (scheme + host + port).
# Must match APP_PORT or sign-in redirects break.
NEXTAUTH_URL=http://localhost:3081

# Host port the app is published on by docker compose (container runs on 3000).
APP_PORT=3081

# --- Email (recommended) --------------------------------------------------

# SMTP connection string for outgoing mail (sign-in codes, quote request
# notifications, invoice sending, reminders).
# NOTE: the Auth.js provider is constructed during `next build`, so builds
# require this to be set (any syntactically valid value works for building).
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587

# From address for all outgoing mail. Falls back to the business contact
# email configured in Settings → Business when unset.
EMAIL_FROM=noreply@example.com

# Where website quote-request notifications go (defaults to EMAIL_FROM).
# ADMIN_NOTIFICATION_EMAIL=you@example.com

# Where calendar reminder emails go (defaults to EMAIL_FROM).
# OPERATOR_EMAIL=you@example.com

# --- Scheduler --------------------------------------------------------------

# Shared secret for the cron endpoints (X-Cron-Secret header). The compose
# cron sidecar uses this automatically. Generate: openssl rand -hex 24
CRON_SECRET=change-me-cron

# Cron cadence for the compose sidecar (optional).
# CONTRACTS_CRON_SCHEDULE=15 8 * * *
# CALENDAR_CRON_SCHEDULE=0 * * * *

# --- Stripe payments (optional) ---------------------------------------------

# Enables "Pay with card" on shared invoices via Stripe Checkout.
# STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret for POST /api/stripe/webhook (records payments).
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Instance identity (optional) --------------------------------------------

# production | dev | local — non-production instances show a banner, serve a
# noindex robots.txt, emit source maps, and refuse live Stripe keys.
# APP_ENV=production

# Prefix for docker container names; lets two stacks share a host.
# STACK_NAME=marotto

# Published Postgres host port for docker compose.
# POSTGRES_PORT=5433

# Public site URL override when it differs from NEXTAUTH_URL.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Build SHA reported by /api/health (set automatically by the deploy workflow).
# APP_COMMIT_SHA=

# --- First admin account (used by scripts/seed-admin.js) ---------------------
# Prefer the in-app first-run wizard at /setup. The seed script is the
# scripted alternative:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD=... node scripts/seed-admin.js
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
